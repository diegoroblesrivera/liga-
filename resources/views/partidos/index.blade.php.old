        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Si llegamos con un ancla explícita (ej: #fecha-7 desde "Reprogramar"),
            // esa manda por sobre la jornada actual.
            if (window.location.hash && window.location.hash.startsWith('#fecha-')) {
                var el = document.querySelector(window.location.hash);
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    el.classList.add('ring-2', 'ring-[#f53003]');
                    setTimeout(function () {
                        el.classList.remove('ring-2', 'ring-[#f53003]');
                    }, 2000);
                }
                return;
            }

            // Sin ancla explícita: como ya viene primera en el listado, no hace
            // falta hacer scroll, pero la dejamos visible por si el layout cambia.
            var actual = document.querySelector('[data-fecha-actual="1"]');
            if (actual) {
                actual.scrollIntoView({ behavior: 'instant', block: 'start' });
            }
        });
    </script>
</x-app-layout>
